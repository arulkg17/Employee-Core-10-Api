<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Invoice.RAG</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.35" />
		<!-- Keep these two aligned with the versions used by Invoice.CoreAPI / Invoice.DAL. -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
		<!-- Pure .NET PDF text extraction (no native dependencies). -->
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<!-- Pure .NET Word (.docx) text extraction (no Word installation needed). -->
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
		<!-- Swagger / OpenAPI UI -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="..\skills\**\*.*" Link="Skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>


