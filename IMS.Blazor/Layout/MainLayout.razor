@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <nav class="ims-nav">
            <NavLink class="brand" href="" Match="NavLinkMatch.All">IMS</NavLink>

            <NavDropdown Title="Master">
                <NavLink class="dropdown-item" href="categories">Category</NavLink>
                <NavLink class="dropdown-item" href="items">Item Master</NavLink>
                <NavLink class="dropdown-item" href="customers">Customer</NavLink>
                <NavLink class="dropdown-item" href="vendors">Vendor</NavLink>
                <NavLink class="dropdown-item" href="users">User</NavLink>
            </NavDropdown>

            <NavDropdown Title="Transaction">
                <NavLink class="dropdown-item" href="purchase-orders">Purchase Order</NavLink>
                <NavLink class="dropdown-item" href="receipts">Receipt</NavLink>
                <NavLink class="dropdown-item" href="sales-invoices">Sales Invoice</NavLink>
                <NavLink class="dropdown-item" href="stock">Stock</NavLink>
            </NavDropdown>

            <NavDropdown Title="Utilities">
                <NavLink class="dropdown-item" href="ai-assistant">AI Assistant</NavLink>
            </NavDropdown>

            <span class="spacer"></span>

            <span class="user">@context.User.Identity?.Name</span>
            <button class="btn btn-sm btn-outline-light" @onclick="LogoutAsync">Logout</button>
        </nav>

        <main class="container-fluid py-3">
            @Body
        </main>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<ToastHost />

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
