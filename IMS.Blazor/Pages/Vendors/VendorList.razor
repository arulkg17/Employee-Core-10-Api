@page "/vendors"
@inject VendorService Service
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Vendors</PageTitle>

<div class="ims-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0">Vendors</h4>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("vendors/create")'>+ New Vendor</button>
    </div>

    @* ---------- search ---------- *@
    <form class="row g-2 mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-auto"><input class="form-control" placeholder="Code" @bind="code" /></div>
        <div class="col-auto"><input class="form-control" placeholder="Name" @bind="name" /></div>
        <div class="col-auto"><input class="form-control" placeholder="City" @bind="city" /></div>
        <div class="col-auto">
            <select class="form-select" @bind="status">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">Clear</button>
        </div>
    </form>

    @* ---------- table ---------- *@
    <DataTable Items="rows" Loading="loading" EmptyText="No vendors found.">
        <Header>
            <th>Code</th>
            <th>Name</th>
            <th>City</th>
            <th>State</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </Header>
        <Row Context="c">
            <td>@c.VendorCode</td>
            <td>@c.VendorName</td>
            <td>@c.City</td>
            <td>@c.State</td>
            <td><StatusBadge Status="@(c.IsActive ? "Active" : "Inactive")" /></td>
            <td class="ims-actions">
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"vendors/edit/{c.Id}")'>Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => toDelete = c">Delete</button>
            </td>
        </Row>
    </DataTable>

    <Pager Page="page" PageSize="pageSize" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
</div>

<ConfirmDialog Visible="@(toDelete is not null)"
               Title="Delete Vendor"
               ConfirmText="Delete"
               ConfirmClass="btn-danger"
               OnConfirm="DeleteAsync"
               OnCancel="() => toDelete = null">
    Are you sure you want to delete <strong>@toDelete?.VendorName</strong>? This action cannot be undone.
</ConfirmDialog>

@code {
    private List<Vendor> rows = new();
    private bool loading;
    private int page = 1;
    private int pageSize = 10;
    private int total;

    // search boxes
    private string code = "", name = "", city = "", status = "";

    private Vendor? toDelete;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            var filter = new Dictionary<string, string?>
            {
                ["vendorCode"] = code,
                ["vendorName"] = name,
                ["city"] = city,
                ["isActive"] = status,
            };

            var result = await Service.GetPagedAsync(filter, page, pageSize);

            rows = result.Data;
            total = result.TotalRecords;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        code = name = city = status = "";
        page = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int newPage)
    {
        page = newPage;
        await LoadAsync();
    }

    private async Task PageSizeChangedAsync(int newSize)
    {
        pageSize = newSize;
        page = 1;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (toDelete is null)
        {
            return;
        }

        var target = toDelete;
        toDelete = null;

        var result = await Service.DeleteAsync(target.Id);

        if (result.Success)
        {
            Toasts.Success($"{target.VendorName} deleted");
            await LoadAsync();
        }
        else
        {
            // e.g. "Vendor is used in sales invoices and cannot be deleted"
            Toasts.Error(result.MessageOr("Delete failed"));
        }
    }
}
