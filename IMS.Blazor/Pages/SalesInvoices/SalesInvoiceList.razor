@page "/sales-invoices"
@inject SalesInvoiceService Service
@inject CustomerService CustomerApi
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Sales Invoices</PageTitle>

<div class="ims-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0">Sales Invoices</h4>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("sales-invoices/create")'>+ New Sales Invoice</button>
    </div>

    <form class="row g-2 mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-auto"><input class="form-control" placeholder="Invoice no" @bind="invoiceNumber" /></div>
        <div class="col-auto">
            <select class="form-select" @bind="customerId">
                <option value="">All customers</option>
                @foreach (var c in customers)
                {
                    <option value="@c.Id">@c.CustomerCode - @c.CustomerName</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select" @bind="status">
                <option value="">All statuses</option>
                @foreach (var s in DocStatuses.All)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">Clear</button>
        </div>
    </form>

    <DataTable Items="rows" Loading="loading" EmptyText="No sales invoices found.">
        <Header>
            <th>Invoice No</th>
            <th>Date</th>
            <th>Due</th>
            <th>Customer</th>
            <th>Status</th>
            <th class="text-end">Total</th>
            <th class="text-end">Actions</th>
        </Header>
        <Row Context="i">
            <td>@i.InvoiceNumber</td>
            <td>@i.InvoiceDate.ToString("dd-MMM-yyyy")</td>
            <td>@(i.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
            <td>@CustomerName(i.CustomerId)</td>
            <td><StatusBadge Status="@i.Status" /></td>
            <td class="text-end">@i.TotalAmount.ToString("N2")</td>
            <td class="ims-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewPdfAsync(i)">PDF</button>
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"sales-invoices/edit/{i.Id}")'>@(i.Status == "Draft" ? "Edit" : "View")</button>

                @if (i.Status == "Draft")
                {
                    <button class="btn btn-sm btn-success" @onclick='() => pending = new PendingAction("post", i)'>Post</button>
                }

                @if (i.Status is "Draft" or "Posted")
                {
                    <button class="btn btn-sm btn-outline-warning" @onclick='() => pending = new PendingAction("cancel", i)'>Cancel</button>
                }

                @if (i.Status == "Draft")
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick='() => pending = new PendingAction("delete", i)'>Delete</button>
                }
            </td>
        </Row>
    </DataTable>

    <Pager Page="page" PageSize="pageSize" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
</div>

<ConfirmDialog Visible="@(pending is not null)"
               Title="@(pending is null ? "" : Verb(pending.Kind) + " Invoice")"
               ConfirmText="@(pending is null ? "Confirm" : Verb(pending.Kind))"
               ConfirmClass="@(pending?.Kind == "post" ? "btn-primary" : pending?.Kind == "cancel" ? "btn-warning" : "btn-danger")"
               OnConfirm="ConfirmPendingAsync"
               OnCancel="() => pending = null">
    @(pending is null ? "" : Verb(pending.Kind)) invoice <strong>@pending?.Invoice.InvoiceNumber</strong>?
</ConfirmDialog>

<PdfPreview @ref="pdf" />

@code {
    private record PendingAction(string Kind, SalesInvoice Invoice);

    private List<SalesInvoice> rows = new();
    private List<Customer> customers = new();
    private bool loading;
    private int page = 1;
    private int pageSize = 10;
    private int total;

    private string invoiceNumber = "", customerId = "", status = "";

    private PendingAction? pending;
    private PdfPreview? pdf;

    private static string Verb(string kind) => kind switch
    {
        "post" => "Post",
        "cancel" => "Cancel",
        _ => "Delete"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            customers = await CustomerApi.GetAllAsync();
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }

        await LoadAsync();
    }

    private string CustomerName(int id)
    {
        var c = customers.FirstOrDefault(x => x.Id == id);

        return c is null ? $"#{id}" : $"{c.CustomerCode} - {c.CustomerName}";
    }

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            var filter = new Dictionary<string, string?>
            {
                ["invoiceNumber"] = invoiceNumber,
                ["customerId"] = customerId,
                ["status"] = status,
            };

            var result = await Service.GetPagedAsync(filter, page, pageSize);

            rows = result.Data;
            total = result.TotalRecords;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        invoiceNumber = customerId = status = "";
        page = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int newPage)
    {
        page = newPage;
        await LoadAsync();
    }

    private async Task PageSizeChangedAsync(int newSize)
    {
        pageSize = newSize;
        page = 1;
        await LoadAsync();
    }

    private Task ViewPdfAsync(SalesInvoice i) =>
        pdf!.ShowAsync(PdfDocType.SalesInvoice, i.Id, $"Sales Invoice {i.InvoiceNumber}");

    private async Task ConfirmPendingAsync()
    {
        if (pending is null)
        {
            return;
        }

        var (kind, invoice) = pending;
        pending = null;

        var result = kind switch
        {
            "post" => await Service.PostAsync(invoice.Id),
            "cancel" => await Service.CancelAsync(invoice.Id),
            _ => await Service.DeleteAsync(invoice.Id),
        };

        if (result.Success)
        {
            Toasts.Success($"{invoice.InvoiceNumber}: {Verb(kind)} done");
        }
        else
        {
            // e.g. "Insufficient stock for item ..."
            Toasts.Error(result.MessageOr("The operation failed"));
        }

        await LoadAsync();
    }
}
