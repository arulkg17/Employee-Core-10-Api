@page "/sales-invoices/create"
@page "/sales-invoices/edit/{Id:int}"
@inject SalesInvoiceService Service
@inject CustomerService CustomerApi
@inject ItemmasterService ItemApi
@inject StockService StockApi
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Sales Invoice</PageTitle>

<div class="ims-card">
    <div class="d-flex align-items-center gap-3 mb-3">
        <h4 class="text-primary fw-bold mb-0">@Title</h4>
        @if (Id > 0)
        {
            <StatusBadge Status="@status" />
        }
    </div>

    @if (editContext is not null)
    {
        <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <fieldset disabled="@IsReadOnly">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Invoice No</label>
                        <InputText class="form-control" @bind-Value="request.InvoiceNumber" disabled="@(Id > 0)" />
                        @if (Id == 0)
                        {
                            <div class="form-text">Leave blank to auto-generate</div>
                        }
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Invoice Date</label>
                        <InputDate class="form-control" @bind-Value="request.InvoiceDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Due Date</label>
                        <InputDate class="form-control" @bind-Value="request.DueDate" />
                        <ValidationMessage For="() => request.DueDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Customer</label>
                        <InputSelect class="form-select" @bind-Value="request.CustomerId">
                            <option value="0">-- select customer --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.Id">@c.CustomerCode - @c.CustomerName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => request.CustomerId" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="request.Notes" />
                        <ValidationMessage For="() => request.Notes" />
                    </div>
                </div>

                @if (!IsReadOnly && AnyShort)
                {
                    <div class="alert alert-warning py-2">
                        Some items need more stock than is on hand. You can still save, but posting will be
                        refused until the stock is available.
                    </div>
                }

                <LinesEditor Lines="request.Details"
                             Items="items"
                             ReadOnly="IsReadOnly"
                             Stock="@(IsReadOnly ? null : stock)"
                             OnChanged="LinesChanged" />
            </fieldset>

            @if (lineErrors.Count > 0)
            {
                <div class="alert alert-danger mt-3 py-2">
                    <ul class="mb-0">
                        @foreach (var error in lineErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <DocumentTotals Value="CurrentTotals" />

            <div class="d-flex flex-wrap gap-2 mt-4">
                @if (!IsReadOnly)
                {
                    <button type="submit" class="btn btn-primary" disabled="@saving">@(Id > 0 ? "Update" : "Save")</button>
                }

                @if (Id > 0)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="ViewPdfAsync">View PDF</button>
                }

                @if (Id > 0 && status == "Draft")
                {
                    <button type="button" class="btn btn-outline-success" disabled="@dirty" title="@(dirty ? "Save your changes first" : "")" @onclick='() => pendingAction = "post"'>Post</button>
                }

                @if (Id > 0 && status is "Draft" or "Posted")
                {
                    <button type="button" class="btn btn-outline-warning" @onclick='() => pendingAction = "cancel"'>Cancel Invoice</button>
                }

                <button type="button" class="btn btn-link" @onclick='() => Nav.NavigateTo("sales-invoices")'>Close</button>
            </div>
        </EditForm>
    }
</div>

<ConfirmDialog Visible="@(pendingAction is not null)"
               Title="@(pendingAction == "post" ? "Post Invoice" : "Cancel Invoice")"
               ConfirmText="@(pendingAction == "post" ? "Post" : "Cancel Invoice")"
               ConfirmClass="@(pendingAction == "post" ? "btn-primary" : "btn-warning")"
               OnConfirm="RunPendingAsync"
               OnCancel="() => pendingAction = null">
    @(pendingAction == "post"
        ? "Post this invoice? The stock will be checked and reduced."
        : "Cancel this invoice? Posted stock is given back.")
</ConfirmDialog>

<PdfPreview @ref="pdf" />

@code {
    [Parameter] public int Id { get; set; }

    private SalesInvoiceRequest request = new();
    private EditContext? editContext;
    private List<Customer> customers = new();
    private List<Itemmaster> items = new();
    private Dictionary<int, decimal> stock = new();
    private List<string> lineErrors = new();
    private string status = "Draft";
    private string? pendingAction;
    private Totals? savedTotals;
    private bool saving, dirty, lookupsLoaded;
    private int loadedId = -1;
    private PdfPreview? pdf;

    private bool IsReadOnly => status != "Draft";

    private string Title => Id == 0 ? "New Sales Invoice" : IsReadOnly ? "View Sales Invoice" : "Edit Sales Invoice";

    private Totals CurrentTotals =>
        IsReadOnly && savedTotals is { } saved
            ? saved
            : Money.Sum(request.Details.Select(d => Money.CalcLine(d)));

    // early warning: the server checks the stock again when the invoice is posted
    private bool AnyShort =>
        request.Details
            .Where(l => l.ItemmasterId > 0)
            .GroupBy(l => l.ItemmasterId)
            .Any(g => g.Sum(l => l.Quantity) > stock.GetValueOrDefault(g.Key));

    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId)
        {
            return;
        }

        loadedId = Id;

        try
        {
            if (!lookupsLoaded)
            {
                customers = await CustomerApi.GetAllAsync();
                items = await ItemApi.GetAllAsync();
                lookupsLoaded = true;
            }

            var stockRows = await StockApi.GetAllAsync();
            stock = stockRows.ToDictionary(s => s.ItemmasterId, s => s.OnHandQuantity);

            if (Id == 0)
            {
                status = "Draft";
                savedTotals = null;
                SetModel(new SalesInvoiceRequest { Details = new List<DocLine> { new() } });
            }
            else
            {
                await LoadInvoiceAsync();
            }
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
            Nav.NavigateTo("sales-invoices");
        }
    }

    private void SetModel(SalesInvoiceRequest model)
    {
        request = model;
        editContext = new EditContext(model);
        editContext.OnFieldChanged += (_, _) => dirty = true;
        lineErrors = new List<string>();
        dirty = false;
    }

    private async Task LoadInvoiceAsync()
    {
        var invoice = await Service.GetByIdAsync(Id);

        if (invoice is null)
        {
            Toasts.Error("Sales invoice not found");
            Nav.NavigateTo("sales-invoices");
            return;
        }

        status = invoice.Status;
        savedTotals = new Totals(invoice.SubTotal, invoice.TaxAmount, invoice.TotalAmount);

        SetModel(new SalesInvoiceRequest
        {
            InvoiceNumber = invoice.InvoiceNumber,
            InvoiceDate = invoice.InvoiceDate,
            DueDate = invoice.DueDate,
            CustomerId = invoice.CustomerId,
            Notes = invoice.Notes,
            Details = invoice.Details.Select(d => new DocLine
            {
                ItemmasterId = d.ItemmasterId,
                Quantity = d.Quantity,
                Rate = d.Rate,
                DiscountAmount = d.DiscountAmount,
                TaxPercent = d.TaxPercent,
            }).ToList(),
        });
    }

    private void LinesChanged()
    {
        dirty = true;
        lineErrors.Clear();
    }

    // ---------------- SAVE ----------------
    private async Task SaveAsync()
    {
        lineErrors = LineValidator.Validate(request.Details);

        if (lineErrors.Count > 0)
        {
            Toasts.Error(lineErrors[0]);
            return;
        }

        // blank invoice number = auto-generate
        request.InvoiceNumber = string.IsNullOrWhiteSpace(request.InvoiceNumber) ? null : request.InvoiceNumber.Trim();
        request.Notes = string.IsNullOrWhiteSpace(request.Notes) ? "" : request.Notes.Trim();

        saving = true;

        try
        {
            var result = Id > 0
                ? await Service.UpdateAsync(Id, request)
                : await Service.CreateAsync(request);

            if (!result.Success)
            {
                Toasts.Error(result.MessageOr("Unable to save the sales invoice"));
                return;
            }

            var savedId = Id > 0 ? Id : result.NewId ?? 0;

            dirty = false;
            Toasts.Success(Id > 0 ? "Sales invoice updated" : "Sales invoice created");

            // show the saved invoice as a PDF copy, then go back to the list
            await pdf!.ShowAsync(
                PdfDocType.SalesInvoice,
                savedId,
                "Sales Invoice",
                onClose: () =>
                {
                    Nav.NavigateTo("sales-invoices");
                    return Task.CompletedTask;
                });
        }
        finally
        {
            saving = false;
        }
    }

    // ---------------- WORKFLOW ----------------
    private Task ViewPdfAsync() => pdf!.ShowAsync(PdfDocType.SalesInvoice, Id, "Sales Invoice");

    private async Task RunPendingAsync()
    {
        var action = pendingAction;
        pendingAction = null;

        var result = action == "post"
            ? await Service.PostAsync(Id)
            : await Service.CancelAsync(Id);

        if (result.Success)
        {
            Toasts.Success(action == "post" ? "Invoice posted" : "Invoice cancelled");
        }
        else
        {
            // e.g. "Insufficient stock for item ..."
            Toasts.Error(result.MessageOr("The operation failed"));
        }

        await LoadInvoiceAsync();
    }
}
