@page "/users"
@inject AppUserService Service
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Users</PageTitle>

<div class="ims-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0">Users</h4>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("users/create")'>+ New User</button>
    </div>

    <form class="row g-2 mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-auto"><input class="form-control" placeholder="User name" @bind="userName" /></div>
        <div class="col-auto"><input class="form-control" placeholder="Email" @bind="email" /></div>
        <div class="col-auto"><input class="form-control" placeholder="City" @bind="city" /></div>
        <div class="col-auto">
            <select class="form-select" @bind="status">
                <option value="">All</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">Clear</button>
        </div>
    </form>

    <DataTable Items="rows" Loading="loading" EmptyText="No users found.">
        <Header>
            <th>User Name</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>City</th>
            <th>State</th>
            <th>Last Login</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </Header>
        <Row Context="u">
            <td>@u.UserName</td>
            <td>@u.DisplayName</td>
            <td>@u.Email</td>
            <td>@u.PhoneNumber</td>
            <td>@u.City</td>
            <td>@u.State</td>
            <td>@(u.LastLoginDate?.ToString("dd-MMM-yyyy HH:mm") ?? "-")</td>
            <td><StatusBadge Status="@(u.IsActive ? "Active" : "Inactive")" /></td>
            <td class="ims-actions">
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"users/edit/{u.Id}")'>Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => toDelete = u">Delete</button>
            </td>
        </Row>
    </DataTable>

    <Pager Page="page" PageSize="pageSize" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
</div>

<ConfirmDialog Visible="@(toDelete is not null)"
               Title="Delete User"
               ConfirmText="Delete"
               ConfirmClass="btn-danger"
               OnConfirm="DeleteAsync"
               OnCancel="() => toDelete = null">
    Are you sure you want to delete <strong>@toDelete?.UserName</strong>? This action cannot be undone.
</ConfirmDialog>

@code {
    private List<AppUser> rows = new();
    private bool loading;
    private int page = 1;
    private int pageSize = 10;
    private int total;

    private string userName = "", email = "", city = "", status = "";

    private AppUser? toDelete;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            var filter = new Dictionary<string, string?>
            {
                ["userName"] = userName,
                ["email"] = email,
                ["city"] = city,
                ["isActive"] = status,
            };

            var result = await Service.GetPagedAsync(filter, page, pageSize);

            rows = result.Data;
            total = result.TotalRecords;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        userName = email = city = status = "";
        page = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int newPage)
    {
        page = newPage;
        await LoadAsync();
    }

    private async Task PageSizeChangedAsync(int newSize)
    {
        pageSize = newSize;
        page = 1;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (toDelete is null)
        {
            return;
        }

        var target = toDelete;
        toDelete = null;

        var result = await Service.DeleteAsync(target.Id);

        if (result.Success)
        {
            Toasts.Success($"{target.UserName} deleted");
            await LoadAsync();
        }
        else
        {
            Toasts.Error(result.MessageOr("Delete failed"));
        }
    }
}
