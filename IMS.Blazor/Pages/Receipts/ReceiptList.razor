@page "/receipts"
@inject ReceiptService Service
@inject PurchaseOrderService PoApi
@inject VendorService VendorApi
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Receipts</PageTitle>

<div class="ims-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0">Receipts (Goods Receipt)</h4>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("receipts/create")'>+ New Receipt</button>
    </div>

    <form class="row g-2 mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-auto"><input class="form-control" placeholder="Receipt no" @bind="receiptNumber" /></div>
        <div class="col-auto">
            <select class="form-select" @bind="purchaseOrderId">
                <option value="">All purchase orders</option>
                @foreach (var o in orders)
                {
                    <option value="@o.Id">@o.PoNumber</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select" @bind="vendorId">
                <option value="">All vendors</option>
                @foreach (var v in vendors)
                {
                    <option value="@v.Id">@v.VendorCode - @v.VendorName</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <select class="form-select" @bind="status">
                <option value="">All statuses</option>
                @foreach (var s in DocStatuses.All)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">Clear</button>
        </div>
    </form>

    <DataTable Items="rows" Loading="loading" EmptyText="No receipts found.">
        <Header>
            <th>Receipt No</th>
            <th>Date</th>
            <th>PO</th>
            <th>Vendor</th>
            <th>Status</th>
            <th class="text-end">Total</th>
            <th class="text-end">Actions</th>
        </Header>
        <Row Context="r">
            <td>@r.ReceiptNumber</td>
            <td>@r.ReceiptDate.ToString("dd-MMM-yyyy")</td>
            <td>@PoNumber(r.PurchaseOrderId)</td>
            <td>@VendorName(r.VendorId)</td>
            <td><StatusBadge Status="@r.Status" /></td>
            <td class="text-end">@r.TotalAmount.ToString("N2")</td>
            <td class="ims-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewPdfAsync(r)">PDF</button>
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"receipts/edit/{r.Id}")'>@(r.Status == "Draft" ? "Edit" : "View")</button>

                @if (r.Status == "Draft")
                {
                    <button class="btn btn-sm btn-success" @onclick='() => pending = new PendingAction("post", r)'>Post</button>
                }

                @if (r.Status is "Draft" or "Posted")
                {
                    <button class="btn btn-sm btn-outline-warning" @onclick='() => pending = new PendingAction("cancel", r)'>Cancel</button>
                }

                @if (r.Status == "Draft")
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick='() => pending = new PendingAction("delete", r)'>Delete</button>
                }
            </td>
        </Row>
    </DataTable>

    <Pager Page="page" PageSize="pageSize" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
</div>

<ConfirmDialog Visible="@(pending is not null)"
               Title="@(pending is null ? "" : Verb(pending.Kind) + " Receipt")"
               ConfirmText="@(pending is null ? "Confirm" : Verb(pending.Kind))"
               ConfirmClass="@(pending?.Kind == "post" ? "btn-primary" : pending?.Kind == "cancel" ? "btn-warning" : "btn-danger")"
               OnConfirm="ConfirmPendingAsync"
               OnCancel="() => pending = null">
    @(pending is null ? "" : Verb(pending.Kind)) receipt <strong>@pending?.Receipt.ReceiptNumber</strong>?
</ConfirmDialog>

<PdfPreview @ref="pdf" />

@code {
    private record PendingAction(string Kind, Receipt Receipt);

    private List<Receipt> rows = new();
    private List<Vendor> vendors = new();
    private List<PurchaseOrder> orders = new();
    private bool loading;
    private int page = 1;
    private int pageSize = 10;
    private int total;

    private string receiptNumber = "", purchaseOrderId = "", vendorId = "", status = "";

    private PendingAction? pending;
    private PdfPreview? pdf;

    private static string Verb(string kind) => kind switch
    {
        "post" => "Post",
        "cancel" => "Cancel",
        _ => "Delete"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            vendors = await VendorApi.GetAllAsync();
            orders = await PoApi.GetAllAsync();
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }

        await LoadAsync();
    }

    private string VendorName(int id)
    {
        var v = vendors.FirstOrDefault(x => x.Id == id);

        return v is null ? $"#{id}" : $"{v.VendorCode} - {v.VendorName}";
    }

    private string PoNumber(int id) =>
        orders.FirstOrDefault(o => o.Id == id)?.PoNumber ?? $"#{id}";

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            var filter = new Dictionary<string, string?>
            {
                ["receiptNumber"] = receiptNumber,
                ["purchaseOrderId"] = purchaseOrderId,
                ["vendorId"] = vendorId,
                ["status"] = status,
            };

            var result = await Service.GetPagedAsync(filter, page, pageSize);

            rows = result.Data;
            total = result.TotalRecords;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        receiptNumber = purchaseOrderId = vendorId = status = "";
        page = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int newPage)
    {
        page = newPage;
        await LoadAsync();
    }

    private async Task PageSizeChangedAsync(int newSize)
    {
        pageSize = newSize;
        page = 1;
        await LoadAsync();
    }

    private Task ViewPdfAsync(Receipt r) =>
        pdf!.ShowAsync(PdfDocType.Receipt, r.Id, $"Goods Receipt {r.ReceiptNumber}");

    private async Task ConfirmPendingAsync()
    {
        if (pending is null)
        {
            return;
        }

        var (kind, receipt) = pending;
        pending = null;

        var result = kind switch
        {
            "post" => await Service.PostAsync(receipt.Id),
            "cancel" => await Service.CancelAsync(receipt.Id),
            _ => await Service.DeleteAsync(receipt.Id),
        };

        if (result.Success)
        {
            Toasts.Success($"{receipt.ReceiptNumber}: {Verb(kind)} done");
        }
        else
        {
            // e.g. "Cannot cancel: the received stock was already sold"
            Toasts.Error(result.MessageOr("The operation failed"));
        }

        await LoadAsync();
    }
}
