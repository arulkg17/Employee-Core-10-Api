@page "/categories"
@inject CategoryService Service
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Categories</PageTitle>

<div class="ims-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0">Categories</h4>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("categories/create")'>+ New Category</button>
    </div>

    <form class="row g-2 mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-auto"><input class="form-control" placeholder="Code" @bind="code" /></div>
        <div class="col-auto"><input class="form-control" placeholder="Name" @bind="name" /></div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync">Clear</button>
        </div>
    </form>

    <DataTable Items="rows" Loading="loading" EmptyText="No categories found.">
        <Header>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </Header>
        <Row Context="c">
            <td>@c.Code</td>
            <td>@c.Name</td>
            <td>@c.Description</td>
            <td><StatusBadge Status="@(c.IsActive ? "Active" : "Inactive")" /></td>
            <td class="ims-actions">
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"categories/edit/{c.Id}")'>Edit</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => toDelete = c">Delete</button>
            </td>
        </Row>
    </DataTable>

    <Pager Page="page" PageSize="pageSize" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="PageSizeChangedAsync" />
</div>

<ConfirmDialog Visible="@(toDelete is not null)"
               Title="Delete Category"
               ConfirmText="Delete"
               ConfirmClass="btn-danger"
               OnConfirm="DeleteAsync"
               OnCancel="() => toDelete = null">
    Are you sure you want to delete <strong>@toDelete?.Name</strong>? This action cannot be undone.
</ConfirmDialog>

@code {
    private List<Category> rows = new();
    private bool loading;
    private int page = 1;
    private int pageSize = 10;
    private int total;

    private string code = "", name = "";

    private Category? toDelete;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        try
        {
            var filter = new Dictionary<string, string?> { ["code"] = code, ["name"] = name };
            var result = await Service.GetPagedAsync(filter, page, pageSize);

            rows = result.Data;
            total = result.TotalRecords;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync()
    {
        page = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        code = name = "";
        page = 1;
        await LoadAsync();
    }

    private async Task PageChangedAsync(int newPage)
    {
        page = newPage;
        await LoadAsync();
    }

    private async Task PageSizeChangedAsync(int newSize)
    {
        pageSize = newSize;
        page = 1;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (toDelete is null)
        {
            return;
        }

        var target = toDelete;
        toDelete = null;

        var result = await Service.DeleteAsync(target.Id);

        if (result.Success)
        {
            Toasts.Success($"{target.Name} deleted");
            await LoadAsync();
        }
        else
        {
            Toasts.Error(result.MessageOr("Delete failed"));
        }
    }
}
