@page "/categories/create"
@page "/categories/edit/{Id:int}"
@inject CategoryService Service
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>@(Id > 0 ? "Edit Category" : "New Category")</PageTitle>

<div class="ims-card" style="max-width: 900px;">
    <h4 class="text-primary fw-bold mb-3">@(Id > 0 ? "Edit Category" : "New Category")</h4>

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Code</label>
                <InputText class="form-control" @bind-Value="model.Code" />
                <ValidationMessage For="() => model.Code" />
            </div>

            <div class="col-md-8">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="model.Name" />
                <ValidationMessage For="() => model.Name" />
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="model.Description" />
                <ValidationMessage For="() => model.Description" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="active" @bind-Value="model.IsActive" />
                    <label class="form-check-label" for="active">Active</label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@saving">@(Id > 0 ? "Update" : "Save")</button>
            <button type="button" class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("categories")'>Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Category model = new();
    private bool saving;
    private int loadedId = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId)
        {
            return;
        }

        loadedId = Id;

        if (Id == 0)
        {
            model = new Category();
            return;
        }

        try
        {
            var category = await Service.GetByIdAsync(Id);

            if (category is null)
            {
                Toasts.Error("Category not found");
                Nav.NavigateTo("categories");
                return;
            }

            model = category;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);
            Nav.NavigateTo("categories");
        }
    }

    private async Task SaveAsync()
    {
        model.Code = model.Code.Trim();
        model.Name = model.Name.Trim();
        model.Description = string.IsNullOrWhiteSpace(model.Description) ? null : model.Description.Trim();

        saving = true;

        try
        {
            var result = Id > 0
                ? await Service.UpdateAsync(Id, model)
                : await Service.CreateAsync(model);

            if (!result.Success)
            {
                Toasts.Error(result.MessageOr("Save failed"));
                return;
            }

            Toasts.Success(Id > 0 ? "Category updated successfully" : "Category created successfully");
            Nav.NavigateTo("categories");
        }
        finally
        {
            saving = false;
        }
    }
}
