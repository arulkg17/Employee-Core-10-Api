<div class="ms-auto mt-3" style="width: 280px;">
    <div class="d-flex justify-content-between">
        <span>Sub Total</span>
        <span>@Value.SubTotal.ToString("N2")</span>
    </div>
    <div class="d-flex justify-content-between">
        <span>Tax</span>
        <span>@Value.TaxAmount.ToString("N2")</span>
    </div>
    <div class="d-flex justify-content-between border-top mt-1 pt-1 fw-bold">
        <span>Total</span>
        <span>@Value.TotalAmount.ToString("N2")</span>
    </div>
</div>

@code {
    [Parameter] public Totals Value { get; set; }
}
