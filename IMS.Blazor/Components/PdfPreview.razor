@implements IAsyncDisposable
@inject PdfService Pdfs
@inject IJSRuntime JS
@inject ToastService Toasts

@if (_visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_title</h5>
                </div>
                <div class="modal-body p-0">
                    <iframe id="@FrameId" src="@_url" title="PDF preview" style="width:100%; height:70vh; border:0;"></iframe>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="DownloadAsync">Download</button>
                    <button class="btn btn-outline-secondary" @onclick="PrintAsync">Print</button>
                    <button class="btn btn-outline-secondary" @onclick="CloseAsync">Close</button>

                    @if (_actionLabel is not null && _onAction is not null)
                    {
                        <button class="btn btn-primary" @onclick="ActionAsync">@_actionLabel</button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private const string FrameId = "ims-pdf-frame";

    private bool _visible;
    private string _title = "";
    private string _fileName = "document.pdf";
    private string? _url;
    private string? _actionLabel;
    private Func<Task>? _onAction;
    private Func<Task>? _onClose;

    /// <summary>True while the PDF is being downloaded (use it to disable the "View PDF" button).</summary>
    public bool Loading { get; private set; }

    /// <summary>
    /// Downloads the PDF and shows it in a dialog.
    /// actionLabel / onAction add one extra button (for example "Approve");
    /// onClose runs after the dialog is closed (and after the action, if it was clicked).
    /// </summary>
    public async Task ShowAsync(
        PdfDocType type,
        int id,
        string title,
        string? actionLabel = null,
        Func<Task>? onAction = null,
        Func<Task>? onClose = null)
    {
        Loading = true;
        StateHasChanged();

        try
        {
            var bytes = await Pdfs.GetPdfAsync(type, id);

            await ReleaseAsync();

            _url = await JS.InvokeAsync<string>("imsPdf.createUrl", bytes, "application/pdf");
            _title = title;
            _fileName = $"{type}-{id}.pdf";
            _actionLabel = actionLabel;
            _onAction = onAction;
            _onClose = onClose;
            _visible = true;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Message);

            // the caller may still want to continue (for example go back to the list)
            if (onClose is not null)
            {
                await onClose();
            }
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task CloseAsync()
    {
        var onClose = _onClose;

        await ReleaseAsync();
        _visible = false;

        if (onClose is not null)
        {
            await onClose();
        }
    }

    private async Task ActionAsync()
    {
        var onAction = _onAction;
        var onClose = _onClose;

        await ReleaseAsync();
        _visible = false;

        if (onAction is not null)
        {
            await onAction();
        }

        if (onClose is not null)
        {
            await onClose();
        }
    }

    private Task DownloadAsync() => _url is null
        ? Task.CompletedTask
        : JS.InvokeVoidAsync("imsPdf.download", _url, _fileName).AsTask();

    private Task PrintAsync() => JS.InvokeVoidAsync("imsPdf.print", FrameId).AsTask();

    private async Task ReleaseAsync()
    {
        if (_url is not null)
        {
            await JS.InvokeVoidAsync("imsPdf.revoke", _url);
            _url = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ReleaseAsync();
        }
        catch (JSDisconnectedException)
        {
            // the browser tab is already gone
        }
    }
}
