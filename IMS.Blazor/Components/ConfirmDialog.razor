@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="OnCancel">Cancel</button>
                    <button class="btn @ConfirmClass" @onclick="OnConfirm">@ConfirmText</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public string Title { get; set; } = "Please confirm";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Confirm";

    /// <summary>Bootstrap button class, for example btn-danger or btn-warning.</summary>
    [Parameter] public string ConfirmClass { get; set; } = "btn-primary";

    [Parameter] public EventCallback OnConfirm { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
}
