<span class="badge @Css">@Status</span>

@code {
    [Parameter] public string Status { get; set; } = "";

    private string Css => Status switch
    {
        "Approved" => "text-bg-info",
        "PartiallyReceived" => "text-bg-warning",
        "Received" or "Posted" or "Active" => "text-bg-success",
        "Cancelled" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
